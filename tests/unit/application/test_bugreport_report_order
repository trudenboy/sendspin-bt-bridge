"""A bug report cut to GitHub's size limit must still carry the logs.

Reports submitted from the web UI without a GitHub account put the whole
text report in the issue body, cut from the end to fit GitHub's limit. The
logs came last, after a raw JSON dump that alone can fill the limit, so
those reports (#516, #406, #459) reached the tracker with every log line
cut off — the part a bug report most needs. The logs now come before the
raw JSON and the config, which are the parts a cut can afford to lose.
"""

from __future__ import annotations

from sendspin_bridge.application.diagnostics import _build_full_text_report


def _masked() -> dict:
    return {
        "environment": {"python": "3.13"},
        "diagnostics": {"devices": [{"name": f"Speaker {i}", "blob": "x" * 200} for i in range(400)]},
        "config": {"BRIDGE_NAME": "test"},
        "recent_issue_logs": ["2026-10-09 08:19:30 WARNING Failed to connect: br-connection-page-timeout"],
        "logs": ["2026-10-09 08:19:31 INFO Connecting to 00:0C:8A:00:00:96..."],
    }


def test_logs_come_before_the_raw_json_and_the_config():
    text = _build_full_text_report(_masked())

    logs_at = text.index("RECENT ISSUE LOGS")
    assert logs_at < text.index("RAW DIAGNOSTICS JSON")
    assert logs_at < text.index("CONFIG (sanitized)")
    assert text.index("RECENT LOGS") < text.index("RAW DIAGNOSTICS JSON")


def test_a_report_cut_to_the_issue_limit_keeps_its_log_lines():
    text = _build_full_text_report(_masked())
    assert len(text) > 60000, "the fixture must exceed the limit to test the cut"

    kept = text[:60000]

    assert "br-connection-page-timeout" in kept
    assert "Connecting to 00:0C:8A:00:00:96" in kept
